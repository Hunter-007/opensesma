# On Netlify, leave this unset: Netlify Database provides NETLIFY_DB_URL automatically.
# Elsewhere: a Postgres 14+ connection string (then run `npm run db:migrate`).
# Leave empty in development to use an embedded PGlite database stored in ./.data/pglite
DATABASE_URL=

# 32+ random characters. Used to encrypt estate signing keys and hash OTPs.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=change-me-to-a-long-random-string

# Public URL of the app, used in share links and SMS (no trailing slash)
PUBLIC_APP_URL=http://localhost:5173

# SMS: "console" (dev: prints messages to the server log) or "termii"
SMS_DRIVER=console
TERMII_API_KEY=
TERMII_SENDER_ID=OpenSesma
# Termii channel: "dnd" delivers to DND-enabled numbers (recommended for OTP), or "generic"
TERMII_CHANNEL=dnd

# Web push (generate with: npm run keys:vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Development only: show OTP codes on the login screen. Never enable in production.
DEV_SHOW_OTP=true

# Daily data-retention job (Netlify scheduled function → /api/cron/maintenance)
CRON_SECRET=

# Required in production to create an estate: open /setup?token=<this value>.
SETUP_TOKEN=

# Who can receive login codes (country calling codes, comma-separated) and how many
# codes may be sent per network per hour / across the service per hour (SMS-cost protection).
ALLOWED_COUNTRY_CODES=234
OTP_PER_IP_PER_HOUR=10
OTP_GLOBAL_PER_HOUR=300

# Only while rotating APP_SECRET: the old value (see `npm run secrets:rotate`).
APP_SECRET_PREVIOUS=
